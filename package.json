{
  "name": "eventhorizon",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "lint": "eslint .",
    "check:style": "tsx scripts/check-style.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "ng test --no-watch && vitest run --config vitest.scripts.config.ts",
    "test:coverage": "ng test --no-watch --coverage && vitest run --config vitest.scripts.config.ts",
    "build": "ng build",
    "build:pages": "ng build --base-href /eventhorizon/",
    "e2e": "pnpm build && playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm check:style && pnpm typecheck && pnpm test:coverage && pnpm build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "validate:physics": "tsx bench/physics-validation.ts",
    "validate:steps": "tsx bench/step-rule-sweep.ts",
    "bench:parity": "tsx bench/gpu-parity.ts",
    "bench:cpu-gpu": "tsx bench/cpu-gpu-parity.ts",
    "bench:fallback": "tsx bench/fallback.ts",
    "render:view": "tsx scripts/render-view.ts",
    "capture:baselines": "tsx scripts/capture-baselines.ts",
    "record:preview": "tsx scripts/record-preview.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@ngrx/signals": "22.0.1",
    "katex": "0.19.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "@webgpu/types": "0.1.74",
    "angular-eslint": "22.5.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
